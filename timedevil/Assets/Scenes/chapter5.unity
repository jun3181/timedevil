--- !u!1001 &5179657364693428211
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1746411444}
    m_Modifications:
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
