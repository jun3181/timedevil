    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[0].text
      value: "\uB0B4\uAC00 \uB3C4\uB300\uCCB4... \uBB58 \uC798\uBABB\uD588\uB294\uB370..."
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[1].text
      value: "\uC774\uB7F0\uAC70... \uC81C\uBC1C, \uB204\uAC00 \uC548\uBD24\uC73C\uBA74..."
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[2].text
      value: "\uC5E3..? \uBC8C\uC368?"
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[3].text
      value: "(\uB204\uAD70\uAC00\uAC00 \uC624\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4)"
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[4].text
      value: "..! \uBE68\uB9AC, \uC228\uC9C0 \uC54A\uC73C\uBA74..."
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[5].text
      value: "\uC21C\uCC30\uBCD1\uC744 \uD53C\uD574 \uC801\uB2F9\uD55C \uC9C0\uD615\uC9C0\uBB3C
        \uB4A4\uB098 \uC0C1\uC790, \uD1B5 \uC18D\uC5D0 \uC228\uC5B4\uBCF4\uC790"
