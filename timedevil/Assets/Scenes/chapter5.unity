--- !u!1001 &1121299314
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1746411444}
    m_Modifications:
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.rightPortrait
      value: 
      objectReference: {fileID: 21300000, guid: c47fa7d7138300b4995672f2ef740502,
        type: 3}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[0].text
      value: "[\uC218\uBC30] LUCY / \uAC15\uB3C4\uC0B4\uC778, \uD3ED\uD589\uCE58\uC0AC 
        / \uBAA9\uACA9\uC2DC \uC2E0\uACE0\uBC14\uB78C"
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[1].text
      value: "\uC774\uAC8C... \uB9C8\uC9C0\uB9C9\uC774\uB824\uB098..."
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[2].text
      value: "\uD558\uC544... \uC77C\uB2E8 \uC800\uAE30 \uB05D\uAE4C\uC9C0 \uAC00\uBCF4\uC790..."
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[3].text
      value: "\uC544\uB2C8, \uC194\uC9C1\uD788 \uBB54 \uC798\uBABB\uC744 \uD588\uB2E4\uACE0
        \uC695\uD558\uAE30\uB4E4 \uAE09\uAE09\uD558\uC2E0\uAC00\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[4].text
      value: "..! \uADF8\uB798\uB3C4 \uC774 \uBD84 \uB9CC\uD07C\uC740 \uC9C4\uC2E4\uC744
        \uC54C\uACE0 \uACC4\uC154\uC11C"
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
        type: 3}
      propertyPath: dialogue.lines.Array.data[5].text
      value: "\uAC89\uBAA8\uC2B5 \uBCF4\uBA74, \uB531\uBD10\uB3C4 \uBB34\uC2A8 \uC0AC\uC5F0\uC774
        \uC788\uC73C\uB2C8\uAE4C \uADF8\uB7AC\uACA0\uC8E0."
      objectReference: {fileID: 0}
    - target: {fileID: 3437280908833003669, guid: 829f21b079089a64a8940a8c2ff09d94,
